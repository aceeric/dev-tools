#!/usr/bin/env bash
#
# Creates an ephemeral, graphical AlmaLinux 10 VM for agentic AI development.
# Some supporting "theory" about the code here:
#
# Kickstart is delivered via --initrd-inject + inst.ks=file:/ks.cfg.
# --os-variant almalinux10 is already known to osinfo-db, so --location
# doesn't need an explicit kernel=/initrd= override.
#
# Display: virtio-gpu + SPICE OpenGL/VirGL passthrough, not legacy QXL --
# AlmaLinux re-enabled SPICE support (reversing RHEL 10's removal) but GNOME
# on RHEL10-family is Wayland-only, and QXL's dynamic-resize mechanism relies
# on X11. This requires a real GPU render node on the HOST (check with:
# ls /dev/dri/) -- if that path doesn't exist or isn't VirGL-capable, this
# will fail to start.

# virt-install specifies 120 gig disk because we git clone the various tools
# to avoid rate limiting when curling down releases. Only one console in
# extra args means you can't access the guest using virsh console during guest
# creation. (But you can afterwards.)
#
# After install, this script does one hard virsh destroy+start cycle (not a
# graceful in-guest reboot) because the first boot's SPICE GL session is
# laggy/loses the cursor, and a power-cycle clears it up. It's a *hard* cycle
# specifically because virtiofs is documented to hang a guest's graceful
# shutdown/reboot -- a host-side destroy+start sidesteps that class of bug
# entirely rather than waiting on a guest teardown that may never finish.
#
# Enforce read-only at the host kernel level via a read-only bind mount.
# virtiofs itself has no host-enforced read-only flag -- a guest fstab 'ro'
# entry can be remounted rw by guest root. Since this VM is meant to sandbox
# potentially dangerous processes, the restriction needs to live below the
# guest's own control, so we bind-mount read-only on the host and export
# *that*.
#
# Guest memory/vcpus/disk are sized for a full desktop plus dev tooling;
# adjust as needed.
#
# Script runs the mount commands as sudo. Possible password popup depending
# on how you have sudo configured on the host.
#
set -e

long_opts=vm-name:,linux-iso-path:,os-variant:,host-mount-dir:,\
dev-password:,tools-dir:,host-scripts-manifest:,bashrc-local:,no-dnf-update
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# vars initialized by cmdline
vm_name=
linux_iso_path=
os_variant=
host_mount_dir=
dev_password=
tools_dir=
host_scripts_manifest=
bashrc_local=
no_dnf_update=

# vars initialized by script
host_mount_dir_abs=
password_hash=
ro_bind_dir=

# parse commandline

if ! parsed=$($script_dir/../shared/parseargs $long_opts "$@"); then
  echo "$parsed"
  exit 1
fi

# printf -v avoids eval side-effects (e.g. embedded '$' in arg values)

while IFS='=' read -r name value; do
  [[ -z "$name" ]] && continue
  printf -v "$name" '%s' "$value"
done < <(echo -e "$parsed")

# validate args

for arg in vm_name linux_iso_path os_variant host_mount_dir dev_password; do
  if [[ -z "${!arg}" ]]; then
    echo "--${arg//_/-} is required"
    exit 1
  fi
done
if [[ ! -d "$host_mount_dir" ]]; then
  echo "host mount dir does not exist or is not a directory: $host_mount_dir"
  exit 1
fi

# tools.d/03-opentofu.sh has an explicit -tags http2legacy workaround for a
# known Go 1.27 + x/net v0.54.0 incompatibility. If the Go release available
# today has moved on, that workaround may no longer be needed, or may no
# longer be sufficient for whatever new issue replaced it -- flag it rather
# than silently build against an assumption that might be stale.
expected_go_version="go1.27.1"
current_go_version=$(curl -fsSL "https://go.dev/VERSION?m=text" 2>/dev/null | head -n1)
if [[ -n "$current_go_version" && "$current_go_version" != "$expected_go_version" ]]; then
  echo ""
  echo "IMPORTANT: tools.d/03-opentofu.sh build instructions have an explicit"
  echo "override for Golang 1.27.1 -- current Go release has changed"
  echo "(now $current_go_version) -- recommend to re-assess opentofu build."
  echo ""
  read -p "Press ENTER to continue, or Ctrl-C to abort: "
elif [[ -z "$current_go_version" ]]; then
  echo "warning: couldn't reach go.dev to check current Go version -- skipping check"
fi

if [[ ! -e /dev/dri/renderD128 ]]; then
  echo "warning: /dev/dri/renderD128 not found on this host -- SPICE GL"
  echo "passthrough (virtio-gpu,accel3d=yes) will likely fail to start."
  echo "check 'ls /dev/dri/' for the actual render node on this machine."
fi

# host read-only bind mount prevents guest from ever writing to the host

ro_bind_dir="/mnt/devbox-ro/$vm_name"
host_mount_dir_abs="$(cd "$host_mount_dir" && pwd)"
sudo mkdir -p "$ro_bind_dir"
if ! mountpoint -q "$ro_bind_dir"; then
  sudo mount --bind "$host_mount_dir_abs" "$ro_bind_dir"
  sudo mount -o remount,ro,bind "$ro_bind_dir"
fi
echo "host directory $host_mount_dir_abs is read-only bind-mounted at $ro_bind_dir"

# workspace

work_dir=$(mktemp -d)
cleanup() {
  rm -rf "$work_dir"
}
trap cleanup EXIT

# kickstart

echo "building kickstart"
password_hash=$(openssl passwd -6 "$dev_password")
$script_dir/build-kickstart\
  --template $script_dir/alma-devbox.ks.cfg\
  --password-hash $password_hash\
  --tools-dir=$tools_dir\
  --host-scripts-manifest=$host_scripts_manifest\
  --bashrc-local=$bashrc_local\
  --out $work_dir/ks.cfg

# create vm

echo "creating VM (this runs the full AlmaLinux install; it can take a while)"
virt-install\
  --noautoconsole\
  --wait -1\
  --name $vm_name\
  --memory 8192\
  --vcpus 4\
  --disk size=120\
  --location $linux_iso_path\
  --boot hd,cdrom\
  --os-variant $os_variant\
  --initrd-inject "$work_dir/ks.cfg"\
  --extra-args="inst.ks=file:/ks.cfg console=tty0"\
  --graphics spice,listen=none,gl.enable=yes,gl.rendernode=/dev/dri/renderD128\
  --video virtio,accel3d=yes,heads=2\
  --channel spicevmc,target_type=virtio,name=com.redhat.spice.0\
  --channel unix,target_type=virtio,name=org.qemu.guest_agent.0\
  --filesystem type=mount,accessmode=passthrough,driver.type=virtiofs,source.dir=$ro_bind_dir,target.dir=hostshare\
  --memorybacking access.mode=shared

echo ""
echo "waiting for a DHCP lease to report an IP"
guest_ip=""
for i in $(seq 1 30); do
  guest_ip=$(virsh domifaddr $vm_name 2>/dev/null | awk '/ipv4/ {print $4}' | cut -d/ -f1 | head -n1)
  [[ -n "$guest_ip" ]] && break
  sleep 2
done

if [[ -n "$no_dnf_update" ]]; then
  echo "skipping one-time package update (--no-dnf-update)"
elif [[ -z "$guest_ip" ]]; then
  echo "warning: no IP found -- skipping the one-time package update"
elif ! command -v sshpass >/dev/null 2>&1; then
  echo "warning: sshpass not found on this host -- skipping the one-time"
  echo "package update. Install it (e.g. 'sudo apt install sshpass') to"
  echo "enable this step."
else
  echo "waiting for sshd to accept connections"
  ssh_opts=(-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5)
  ssh_ready=0
  for i in $(seq 1 30); do
    if sshpass -p "$dev_password" ssh "${ssh_opts[@]}" "dev@$guest_ip" true 2>/dev/null; then
      ssh_ready=1
      break
    fi
    sleep 5
  done

  if [[ "$ssh_ready" -eq 0 ]]; then
    echo "warning: sshd did not become reachable -- skipping the one-time"
    echo "package update"
  else
    echo "running one-time package update over SSH before first login (so"
    echo "the graphics stack never updates out from under an active session)"
    sshpass -p "$dev_password" ssh "${ssh_opts[@]}" "dev@$guest_ip" \
      "sudo dnf -y update && sudo dnf clean all" || \
      echo "warning: package update failed or was incomplete -- continuing anyway"
  fi
fi

echo ""
echo "waiting for the guest agent to respond before power-cycling (this also"
echo "confirms the system has settled past first-boot housekeeping, not"
echo "mid-write on anything)"

agent_ready=0
for i in $(seq 1 60); do
  if virsh qemu-agent-command $vm_name '{"execute":"guest-ping"}' >/dev/null 2>&1; then
    agent_ready=1
    break
  fi
  sleep 5
done
if [[ "$agent_ready" -eq 0 ]]; then
  echo "warning: guest agent did not respond after 5 minutes -- proceeding"
  echo "with the power-cycle anyway, but this is less safe than usual"
fi

echo "cycling the VM once (virsh destroy + start) to clear up first-boot"
echo "SPICE GL lag/cursor glitches, and to boot into any just-installed"
echo "kernel/graphics-stack updates cleanly -- NOT a graceful in-guest"
echo "reboot, since virtiofs is known to hang graceful guest shutdowns; a"
echo "hard power-cycle from the host side avoids that entirely"
virsh destroy $vm_name
sleep 2
virsh start $vm_name

echo ""
echo "waiting for a DHCP lease to report the post-cycle IP (may differ from"
echo "the one above)"
guest_ip=""
for i in $(seq 1 30); do
  guest_ip=$(virsh domifaddr $vm_name 2>/dev/null | awk '/ipv4/ {print $4}' | cut -d/ -f1 | head -n1)
  [[ -n "$guest_ip" ]] && break
  sleep 2
done

echo ""
echo "devbox VM '$vm_name' is installed and running."
echo "connect with: virt-viewer --attach $vm_name"
echo "              (listen=none + SPICE GL means --attach is required;"
echo "              plain virt-viewer or remote-viewer + domdisplay will"
echo "              not work with this graphics config)"
echo "host directory is mounted READ-ONLY in the guest at /mnt/hostshare"
if [[ -n "$guest_ip" ]]; then
  echo "ssh (for pulling files out -- SPICE has no guest->host file transfer):"
  echo "  ssh dev@$guest_ip"
else
  echo "ssh: no IP found yet -- check later with: virsh domifaddr $vm_name"
fi

echo "dev tools installed during setup -- kickstart log:"
echo "  root@$vm_name:/root/devbox-tools-kickstart.log"
if [[ -n "$host_scripts_manifest" || -n "$bashrc_local" ]]; then
  echo "host scripts/bashrc extras applied -- kickstart log:"
  echo "  root@$vm_name:/root/devbox-host-extras-kickstart.log"
fi

echo ""
echo "if dynamic resize/clipboard aren't reliable via SPICE, the documented"
echo "fallback is GNOME's built-in Wayland-native Remote Desktop (RDP)"
echo "instead of a SPICE viewer -- see project notes."
